# Copy to .env (git-ignored) and fill in. Scripts read these from the environment;
# cron jobs load the file with `set -a; . ./.env; set +a`.

# SQLite database path (default: app/pelotonia_data.db)
# PELOTONIA_DB=/data/pelotonia_data.db

# Email reports (app/daily_report.py) — Gmail SMTP with an app password
GMAIL_SENDER=you@example.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPORT_RECIPIENT=team-lead@example.com
# REPORT_SENDER_NAME="Pelotonia Dashboard"

# Deploy (deploy-gcp.sh)
# GCP_PROJECT=pelotonia-dashboard
# GCP_REGION=us-central1
# PELOTONIA_GCP_ACCOUNT=you@example.com
